<?xml version="1.0" encoding="utf-8"?>
<!--
    Адаптивная иконка: лаунчер сам обрезает её по своей форме (круг, скруглённый квадрат).
    Рисунок — векторный drawable/ic_launcher_foreground.xml, фон — цвет ic_launcher_background.
    minSdk 28, поэтому растровые ic_launcher.png для Android 7 и ниже не нужны.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
