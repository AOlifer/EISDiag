<?xml version="1.0" encoding="utf-8"?>
<!-- Диагностика машины: журнал событий слева, запись справа, действия с журналом на верхней панели. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Слева значок и название, справа действия с журналом и помощь. -->
    <LinearLayout style="@style/EISDiag.TopBar">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/diag_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMark"
            style="@style/EISDiag.TopIcon"
            android:contentDescription="@string/diag_mark"
            android:src="@drawable/ic_mark"
            android:tooltipText="@string/diag_mark" />

        <ImageButton
            android:id="@+id/btnSnapshot"
            style="@style/EISDiag.TopIcon"
            android:contentDescription="@string/diag_snapshot"
            android:src="@drawable/ic_snapshot"
            android:tooltipText="@string/diag_snapshot" />

        <ImageButton
            android:id="@+id/btnSave"
            style="@style/EISDiag.TopIcon"
            android:contentDescription="@string/diag_save"
            android:src="@drawable/ic_save"
            android:tooltipText="@string/diag_save" />

        <ImageButton
            android:id="@+id/btnClearLog"
            style="@style/EISDiag.TopIcon"
            android:contentDescription="@string/diag_clear"
            android:src="@drawable/ic_clear"
            android:tooltipText="@string/diag_clear" />

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/divider" />

        <ImageButton
            android:id="@+id/btnHelp"
            style="@style/EISDiag.TopIcon"
            android:contentDescription="@string/help"
            android:src="@drawable/ic_help"
            android:tooltipText="@string/help" />
    </LinearLayout>

    <View style="@style/EISDiag.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/diagScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surface">

            <TextView
                android:id="@+id/diagLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <View style="@style/EISDiag.VDivider" />

        <ScrollView
            android:layout_width="@dimen/side_panel_width"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:fillViewport="true">

            <LinearLayout
                style="@style/EISDiag.SidePanel"
                android:layout_width="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/diagStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/EISDiag.Caption"
                    android:layout_marginTop="6dp"
                    android:text="@string/diag_hint" />

                <Button
                    android:id="@+id/btnRecord"
                    style="@style/EISDiag.PrimaryButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/diag_record_start" />

                <View
                    style="@style/EISDiag.Divider"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/diagFiles"
                    style="@style/EISDiag.Caption" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
